# PHASE 04: Flask foundation + DB scripts; business features còn PLANNED.
# Local MongoDB Community8.0 single-node replica set rs0.
APP_ENV=development
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB=ecommerce_dev
MONGODB_TEST_DB=ecommerce_test
API_PORT=5000
API_HOST=127.0.0.1
MONGODB_REPLICA_SET=rs0
MONGODB_TIMEOUT_MS=3000
MAX_CONTENT_LENGTH=1048576
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173
# Optional comma-separated exact origins; leave unset to use FRONTEND_ORIGIN.
# CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000/api/v1
REPORT_TIMEZONE=Asia/Ho_Chi_Minh
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
# scripts/backend/create_env.py generates a private JWT secret in ignored .env.
JWT_ACCESS_TTL_SECONDS=1800
JWT_ISSUER=ecommerce-api
JWT_AUDIENCE=ecommerce-web
# PHASE05C quote key is domain-separated SHA256 from JWT_SECRET; no second secret required.
# Defaults lựa chọn thiết kế, không phải định mức giảng viên.
SHIPPING_FEE_VND=30000
PAYMENT_HOLD_MINUTES=15
PAYMENT_EXPIRY_POLL_SECONDS=30
QUOTE_TTL_SECONDS=300
REPORT_MAX_DAYS=366
VNPAY_ENABLED=false
VNP_TMN_CODE=REPLACE_WITH_SANDBOX_TMN_CODE
VNP_HASH_SECRET=REPLACE_WITH_SANDBOX_HASH_SECRET
VNP_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://127.0.0.1:5000/api/v1/payments/vnpay/return
VNP_IPN_URL=REPLACE_WITH_PUBLIC_HTTPS_IPN_URL
# PHASE06A: bật chỉ khi đủ config hợp lệ; đăng ký IPN URL với merchant Sandbox.
# Ngoài loopback phải HTTPS; không dùng payment production. Không đưa secret vào VITE_ env.
SEED_RANDOM_SEED=20261007
# Set a private development-only password (12..128 chars) before seed --reset.
# Or run scripts/db/create_dev_env.py to generate ignored .env and credential note.
SEED_DEMO_PASSWORD=
