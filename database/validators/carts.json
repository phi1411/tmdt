            },
            "productId": {
              "bsonType": "objectId"
            },
            "quantity": {
              "bsonType": "int",
              "minimum": 1,
              "maximum": 99
            },
            "selectedAttributes": {
              "bsonType": "object",
              "maxProperties": 10,
              "patternProperties": {
                "^.+$": {
                  "bsonType": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "additionalProperties": false
            }
          }
        }
      },
      "couponCode": {
        "bsonType": "string",
        "enum": [
          "NOVA25"
        ]
      }
    }
  }
}
