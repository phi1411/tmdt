        "enum": [
          1
        ]
      },
      "createdAt": {
        "bsonType": "date"
      },
      "updatedAt": {
        "bsonType": "date"
      },
      "userId": {
        "bsonType": "objectId"
      },
      "version": {
        "bsonType": "int",
        "minimum": 1,
        "maximum": 2147483647
      },
      "items": {
        "bsonType": "array",
        "minItems": 0,
        "maxItems": 50,
        "items": {
          "bsonType": "object",
          "additionalProperties": false,
          "required": [
            "lineId",
            "productId",
            "quantity",
            "selectedAttributes"
          ],
          "properties": {
            "lineId": {
              "bsonType": "string",
              "minLength": 64,
              "maxLength": 64,
