[
  {
    "$match": {
      "orderStatus": "COMPLETED",
      "paymentStatus": "PAID",
      "completedAt": {
        "$gte": {
          "$date": "2026-08-31T17:00:00Z"
        },
        "$lt": {
          "$date": "2026-09-30T17:00:00Z"
        }
      }
    }
  },
  {
    "$sort": {
      "completedAt": -1,
      "_id": -1
    }
  },
  {
    "$unwind": "$items"
  },
  {
    "$group": {
      "_id": "$items.categoryId",
      "categoryName": {
        "$first": "$items.categoryName"
      },
      "revenue": {
        "$sum": {
          "$subtract": [
            "$items.lineTotal",
            {
              "$ifNull": [
                "$items.discountAllocated",
                0
              ]
            }
          ]
        }
      }
    }
  },
  {
    "$sort": {
      "revenue": -1,
      "_id": 1
    }
  },
  {
    "$project": {
      "_id": 0,
      "categoryId": "$_id",
      "categoryName": 1,
      "revenue": 1
    }
  }
]
