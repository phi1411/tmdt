[
  {
    "$match": {
      "orderStatus": "COMPLETED",
      "paymentStatus": "PAID",
      "completedAt": {
        "$gte": {
          "$date": "2026-08-31T17:00:00Z"
        },
        "$lt": {
          "$date": "2026-09-30T17:00:00Z"
        }
      }
    }
  },
  {
    "$group": {
      "_id": {
        "$dateTrunc": {
          "date": "$completedAt",
          "unit": "month",
          "timezone": "Asia/Ho_Chi_Minh"
        }
      },
      "revenue": {
        "$sum": {
          "$subtract": [
            "$subtotal",
            "$discount"
          ]
        }
      },
      "orders": {
        "$sum": 1
      }
    }
  },
  {
    "$sort": {
      "_id": 1
    }
  }
]
