[
  {
    "$match": {
      "createdAt": {
        "$gte": {
          "$date": "2026-08-31T17:00:00Z"
        },
        "$lt": {
          "$date": "2026-09-30T17:00:00Z"
        }
      }
    }
  },
  {
    "$group": {
      "_id": "$orderStatus",
      "count": {
        "$sum": 1
      }
    }
  },
  {
    "$sort": {
      "count": -1,
      "_id": 1
    }
  },
  {
    "$project": {
      "_id": 0,
      "status": "$_id",
      "count": 1
    }
  }
]
