[
  {
    "$match": {
      "orderStatus": "COMPLETED",
      "paymentStatus": "PAID",
      "completedAt": {
        "$gte": {
          "$date": "2026-07-03T00:00:00Z"
        },
        "$lt": {
          "$date": "2026-10-01T00:00:00Z"
        }
      }
    }
  },
  {
    "$group": {
      "_id": {
        "$dateTrunc": {
          "date": "$completedAt",
          "unit": "day",
          "timezone": "Asia/Ho_Chi_Minh"
        }
      },
      "revenue": {
        "$sum": {
          "$subtract": [
            "$subtotal",
            "$discount"
          ]
        }
      },
      "orders": {
        "$sum": 1
      }
    }
  },
  {
    "$sort": {
      "_id": 1
    }
  }
]